# Copy to engine/.env and fill in. engine/.env is gitignored — never commit real keys.

# --- Core ---
ANTHROPIC_API_KEY=

# --- Photon (iMessage + voice line) ---
PHOTON_PROJECT_ID=
# Project API key (pho_sk_…) — used as the Bearer token for Photon's REST API
PHOTON_PROJECT_SECRET=
# Your own cell (E.164, e.g. +13105551234): the only number allowed to steer the swarm over iMessage
HIVE_OWNER_PHONE=
# Dedicated iMessage line only: extra people added to each run's group chat (comma-separated +1…)
HIVE_GROUP_MEMBERS=
# Optional: public URL of the live view for "@Web show me" (else http://<LAN IP>:8766/live/)
HIVE_PUBLIC_LIVE_URL=

# --- Voice calls (ElevenLabs hosted agent ⇄ Photon SIP; see docs/CALLS_SETUP.md) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# Either the id of the Photon number imported into ElevenLabs, or the number itself (E.164) to look it up
ELEVENLABS_PHONE_NUMBER_ID=
PHOTON_PHONE_NUMBER=
# Optional: a second voice for the bakery side of simulated calls (call_sim --tts)
ELEVENLABS_THEM_VOICE_ID=
# Name the voice agent says it's calling for
HIVE_USER_NAME=Lucas
# Not needed with the ElevenLabs-hosted agent (kept for a LiveKit fallback)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
# Your own cell, for the first test call (E.164, e.g. +13105551234)
TEST_CALL_NUMBER=

# --- Later ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEVIN_API_KEY=
SENTRY_DSN=

# 1 = Social shares the Instagram post without asking (only for a private demo account)
HIVE_INSTAGRAM_AUTOPOST=

# Optional: scenario name of a local party playbook that texted party requests should run
HIVE_PARTY_SCENARIO=
