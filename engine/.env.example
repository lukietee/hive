# Copy to engine/.env and fill in. engine/.env is gitignored — never commit real keys.

# --- Core ---
ANTHROPIC_API_KEY=

# --- Photon (iMessage + voice line) ---
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# --- Voice calls (LiveKit agent ⇄ Photon SIP) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Your own cell, for the first test call (E.164, e.g. +13105551234)
TEST_CALL_NUMBER=

# --- Later ---
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEVIN_API_KEY=
SENTRY_DSN=
